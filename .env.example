# ─────────────────────────────────────────────────────────────
# UMC 엄마표 영어 — 환경변수 예시. `.env.local` 로 복사해 채운다.
# ─────────────────────────────────────────────────────────────

# Supabase (local: `pnpm supabase:start` 가 출력하는 값)
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 클라이언트(Expo/Next)용 — 빌드 타임 노출되는 값만 EXPO_PUBLIC_ / NEXT_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic — 미코 대화 / 코치 메시지 초안 (MVP에서 유일한 실연동 LLM)
ANTHROPIC_API_KEY=

# 외부 AI (Mock-first — 미설정. 실음성 단계에서 채움)
SPEECHACE_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
GOOGLE_STT_KEY=
OPENAI_API_KEY=

# apps/api (Cloudflare Worker) 로컬 포트
API_PORT=8787
